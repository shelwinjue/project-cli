NODE_ENV=
# NestJS
PORT=3000
CORS_ORIGIN=*

# 浙江算力模型网关
# Base URL 只填写 API 根路径，不包含 /chat/completions。
AIZJ_BASE_URL=https://ai.zj-computility.com/maas/v1
AIZJ_API_KEY=change-me

# Mastra Storage
# database 和用户需要提前创建；Mastra 启动时自动创建自身所需的表和索引。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agent_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=agent_app
