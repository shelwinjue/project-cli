{
  "name": "mastra-nest-agent-starter",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS and Mastra agent service scaffold",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node build/main.js",
    "mastra:studio": "mastra studio --port 4111",
    "mastra:build": "mastra build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible-v5": "npm:@ai-sdk/openai-compatible@1.0.46",
    "@ai-sdk/provider-v5": "npm:@ai-sdk/provider@2.0.3",
    "@mastra/core": "1.71.0",
    "@mastra/memory": "1.30.0",
    "@mastra/mysql": "0.9.0",
    "@mastra/nestjs": "0.2.26",
    "@mastra/observability": "1.17.8",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/throttler": "6.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@types/express": "5.0.6",
    "@types/node": "25.6.2",
    "mastra": "1.29.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  }
}
